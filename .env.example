# ChatGPTBridge 配置模板。复制为 .env 后按需修改；真实环境变量优先于本文件。

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8002

# ---- 路径 ----
USER_DATA_DIR=./user_data
OUTPUT_DIR=./output
SESSION_FILE=./user_data/.chatgpt_state

# ---- 运行模式 / 调试 ----
HEADLESS=false
CHATGPT_DEBUG=false
# /session/reset 的可选令牌；留空 = 不校验
RESET_TOKEN=
# /v1/chat/completions 流式 keep-alive 间隔（秒），0 = 关闭
CHAT_KEEPALIVE_S=10.0

# ---- 回复结束检测 / 超时 ----
CHATGPT_TIMEOUT=180
# 总超时到点但页面仍在生成时，额外延长等待的秒数（0=不延长，旧行为）
RESPONSE_TIMEOUT_EXTEND_S=300
POLL_INTERVAL_S=1.5
STABLE_POLLS=5
LEN_STABLE_POLLS=8
STALL_POLLS=20
# 结束判定的「内容静默窗口」：即便停止按钮已消失 / 文本已稳定，也要求页面
# 内容在连续这么多次轮询里完全不再变化才收尾。用于区分「真的结束」与
# 「分段输出间的短暂停顿」（ChatGPT 常先给正文、停顿、再补 TOOL_CALL）。
RESUME_QUIET_POLLS=4

# ---- 重试 ----
CHATGPT_RETRIES=2
RETRY_BACKOFF_S=1.0

# ---- 会话生命周期 ----
CHATGPT_NEW_SESSION=false
SESSION_KEY_HEADER=X-ChatGPT-Session
SESSION_SCOPING=true
SESSION_SCOPING_BY_UA=true
SESSION_KEY_MAX_LEN=64
MAX_SESSION_BUCKETS=3
MAX_SESSION_STATE_CACHE=64
BUCKET_IDLE_TTL_S=900
PARALLEL_BUCKETS=false
# 同桶请求排队上限（秒）：0=一直等。默认 120，覆盖网页版单轮常见耗时
BUCKET_LOCK_TIMEOUT_S=120
# 流式路径遇到「桶已忙」：false=直接返回 HTTP 503（让客户端退避），true=排队等待
BUCKET_LOCK_QUEUE=false
READY_TIMEOUT_MS=15000
# 单次 fill() 填充输入框的超时（毫秒）；失败会重新定位输入框并重试
FILL_TIMEOUT_MS=10000
# fill 的重试次数（每次重新定位，规避 React 重挂载导致的失效句柄）
FILL_RETRIES=3
# 单次 fill() 入参硬上限；超出保留头尾、截中间（0 不限）
PROMPT_MAX_CHARS=1000000
# 单条 tool 结果注入 prompt 的最大字符数；超出截断（0 不限）
TOOL_RESULT_MAX_CHARS=20000
# 工具说明是否输出每个工具的完整 JSON Schema（false=紧凑，只列 name(必填参数)）
TOOLS_INSTRUCTION_VERBOSE=false
# 工具说明里单条描述的最大字符数（0=不限制）
TOOLS_DESC_MAX_CHARS=200
SEED_MAX_CHARS=12000
SEED_SYSTEM_MAX_CHARS=2000
# 新会话播种时，紧跟在 [上下文重建] 头之后注入的环境说明：告知模型 git 仓库
# 就在本地、可直接执行 git 命令，无需索要仓库地址或让用户手动执行。留空则不注入。
SEED_ENV_NOTE=[环境说明] 执行环境在用户电脑上，你直接下命令，我来返回执行结果。不要访问GitHub。不要访问ChatGPT隔离环境。
SESSION_MAX_TURNS=120
SESSION_MAX_TOKENS=10000000
CAP_CHECK_EVERY=4

# ---- 代码落盘 ----
SAVE_FILES=false
OUTPUT_MAX_FILES=0
OUTPUT_MAX_AGE_DAYS=0

# ---- Responses API（Codex CLI）----
ENABLE_RESPONSES_API=true
RESPONSES_KEEPALIVE_S=10.0
RESPONSES_TOOL_BUFFER=true

# ---- 任务快照 ----
TASK_SNAPSHOT_ENABLED=true
TASK_FILE_DIR=./user_data/.chatgpt_tasks
TASK_NAMESPACE=
TASK_GOAL_MAX_CHARS=2000
TASK_KEEP_MESSAGES=8
TASK_RECENT_ITEM_MAX_CHARS=500

# 「会话到顶」提示语的匹配规则（"||" 分隔多条正则，大小写不敏感）。
# 网页版到顶时会弹提示并停止响应，必须能与“真的卡住”区分开。
CAP_NOTICE_PATTERNS=达到对话长度上限||对话长度上限||已达到长度限制||达到长度限制||开启新对话||开始新的聊天||context length limit||start a new chat

# ---- DOM 选择器 ----
RESPONSE_SELECTORS=message-content, .model-response-text, .markdown, div[class*="response"]
INPUT_SELECTORS=rich-textarea [contenteditable="true"]||div[contenteditable="true"]||textarea[placeholder*="Ask"]||textarea
READY_SELECTOR=rich-textarea, [contenteditable="true"], textarea
NEW_CHAT_SELECTOR=button[aria-label*="New chat"]||button[aria-label*="new chat"]||button[aria-label*="新对话"]||button[aria-label*="新聊天"]

# ---- 默认开启「思考模式」----
# 每次新建对话 / 轮转会话后自动选中 composer 上的 Think 模式，否则网页版以
# 简版模型作答、回复过于简单。控件是 button.__composer-pill（文本含 Think），
# 选中后 aria-pressed="true"。关闭则保持网页默认模式。
THINK_MODE_DEFAULT=true
# Think 按钮候选选择器（"||" 分隔，逐个尝试）
THINK_MODE_SELECTOR=button.__composer-pill||button[class*="__composer-pill"]
# 判定为「思考模式」按钮的文本关键词（大小写不敏感，"||" 分隔）
THINK_MODE_TEXTS=think||思考
CODE_BLOCK_SELECTOR=pre
CODE_TAG_SELECTOR=code

# ---- 内置工具：edit_markdown ----
# 允许桥接层本地执行 edit_markdown（Markdown 锚点编辑）。
# 关闭时 edit_markdown 仍可被解析，但由客户端自行执行。
EDIT_MARKDOWN_LOCAL=true
# edit_markdown 落盘前的备份目录。
EDIT_MARKDOWN_BACKUP_DIR=output/backups

# 发送按钮候选选择器（"||" 分隔多个候选）。
# 提交优先走真实键盘 Enter，其次合成 DOM 事件，只有都无效时才点它。
SEND_BUTTON_SELECTORS=button[data-testid="send-button"]||button[aria-label="Send prompt"]||button[aria-label*="Send"]||button[type="submit"]
